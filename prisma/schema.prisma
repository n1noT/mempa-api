// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username      String?
  password  String
  createdAt DateTime @default(now())
}

model MusicStyle {
  id        Int        @id @default(autoincrement())
  name      String
  playlists Playlist[]
  tracks    Track[]
}

model Playlist {
  id           Int      @id @default(autoincrement())
  name         String
  creator      String
  clicks       Int      @default(0) //0 par defaut
  styleId      Int
  style        MusicStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  contributors String[] //liste des noms de contributeurs en String
  tracks       PlaylistTrack[]
  createdAt    DateTime @default(now())
}

model Track {
  id         Int      @id @default(autoincrement())
  title      String
  artist     String
  styleId    Int
  style     MusicStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)
  playlists PlaylistTrack[]
  addedAt    DateTime @default(now())// pour trier par heures
}

model PlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int
  trackId    Int
  order      Int

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId, order])
}