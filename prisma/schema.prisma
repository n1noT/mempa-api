// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  username             String?
  password             String
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  
  createdPlaylists     Playlist[]            @relation("PlaylistCreator")
  addedTracks          PlaylistTrack[]       @relation("TrackAdder")
}

enum UserRole {
  USER
  ADMIN
}

model MusicStyle {
  id        Int        @id @default(autoincrement())
  name      String     @db.Citext // Case insensitive to enhance sorting
  playlists Playlist[]
  tracks    Track[]
}

model Playlist {
  id           Int                   @id @default(autoincrement())
  name         String                @db.Citext
  clicks       Int                   @default(0)
  
  creatorId    Int
  creator      User                  @relation("PlaylistCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  styleId      Int
  style        MusicStyle            @relation(fields: [styleId], references: [id], onDelete: Cascade)

  tracks       PlaylistTrack[]
  createdAt    DateTime              @default(now())
}

model Track {
  id              Int             @id @default(autoincrement())
  title           String
  artist          String
  album           String?
  genre           String?
  durationSeconds Int?
  coverUrl        String?
  audioUrl        String?
  
  styleId         Int
  style           MusicStyle      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  
  playlists       PlaylistTrack[]
  addedAt         DateTime        @default(now())
}

model PlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int
  trackId    Int
  order      Int
  
  addedById  Int
  addedBy    User     @relation("TrackAdder", fields: [addedById], references: [id], onDelete: Cascade)

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId, order])
}