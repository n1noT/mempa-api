meta {
  name: create-playlist
  type: http
  seq: 4
}

post {
  url: {{url}}/playlist
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Playlist de Bruno",
    "styleId": 1,
    "tracks": [
      {
        "entryId": null,
        "trackId": 1,
        "order": 0
      },
      {
        "entryId": null,
        "trackId": 2,
        "order": 1
      },
      {
        "entryId": null,
        "trackId": 3,
        "order": 2
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Create a new playlist. The creator is set from the active session.
  Tracks are optional at creation; each must belong to the same style as the playlist.

  **Required fields:** `name`, `styleId`
  Requires an active session.
}
