meta {
  name: get-my-playlists
  type: http
  seq: 3
}

get {
  url: {{url}}/playlists/my?sortOrder=asc
  body: none
  auth: inherit
}

params:query {
  sortOrder: asc
  ~sortBy: recent
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Return playlists created by the currently authenticated user.
  Supports the same `sortBy`, `sortOrder`, and `searchTerm` params as `GET /playlists`.

  Requires an active session (401 otherwise).
}
