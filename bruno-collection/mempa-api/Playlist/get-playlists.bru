meta {
  name: get-playlists
  type: http
  seq: 1
}

get {
  url: {{url}}/playlists?sortBy=popularity&sortOrder=asc
  body: none
  auth: inherit
}

params:query {
  sortBy: popularity
  sortOrder: asc
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Return all playlists as a summary list (no tracks).

  **Query params**
  - `sortBy`: `name` | `popularity` | `recent` | `style` (default: `name`)
  - `sortOrder`: `asc` | `desc` (default: `asc`)
  - `searchTerm`: free-text search across name, creator username, and style
}
