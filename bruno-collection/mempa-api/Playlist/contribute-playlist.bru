meta {
  name: contribute-playlist
  type: http
  seq: 6
}

patch {
  url: {{url}}/playlist/1/contribute
  body: json
  auth: inherit
}

body:json {
  {
    "tracksIdsAdded": [
      {
        "trackId": 3,
        "order": 2
      }
    ],
    "tracksIdsRemoved": [
      4,
      6
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Add or remove tracks contributed by the current user on a playlist they did not create.

  - `tracksIdsAdded`: array of `{ trackId, order }` to add
  - `tracksIdsRemoved`: array of `PlaylistTrack.id` entries to remove (only entries added by the caller)

  Tracks must belong to the same style as the playlist. Requires an active session.
}
