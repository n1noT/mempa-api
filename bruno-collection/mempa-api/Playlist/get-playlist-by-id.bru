meta {
  name: get-playlist-by-id
  type: http
  seq: 2
}

get {
  url: {{url}}/playlist/1
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Return the full detail of a playlist including its ordered tracks and contributors.
  Each call increments the playlist's click counter.
}
