meta {
  name: edit-playlist
  type: http
  seq: 5
}

put {
  url: {{url}}/playlist/1
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno",
    "styleId": 1,
    "tracks": [
      {
        "entryId": 1,
        "trackId": 1,
        "order": 0
      },
      {
        "entryId": null,
        "trackId": 3,
        "order": 1
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Replace a playlist's metadata and track list. Only the creator can edit.

  Tracks with a non-null `entryId` are kept (with updated `order`); those with `entryId: null` are created.
  Tracks absent from the payload are deleted.

  Requires an active session. Returns 403 if the caller is not the creator.
}
