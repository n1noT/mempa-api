meta {
  name: create-track
  type: http
  seq: 1
}

post {
  url: {{url}}/tracks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "City of stars",
    "artist": "Ryan Gosling",
    "styleId": 3
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Create a new track. Accepts `multipart/form-data` to optionally upload an audio file (max 20 MB, `audio/*`).
  The uploaded file is stored under `public/uploads/tracks/` and its URL saved in `audioUrl`.

  **Required fields:** `title`, `artist`, `styleId`
  **Optional fields:** `album`, `genre`, `durationSeconds`, `coverUrl`

  **Admin only.** Requires ADMIN role.
}
