meta {
  name: delete-track
  type: http
  seq: 5
}

delete {
  url: {{url}}/tracks/1
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Delete a track by ID. If the track has an associated audio file on disk, it is deleted as well.

  Returns 204 on success. Returns 404 if the track does not exist.

  **Admin only.** Requires ADMIN role.
}
