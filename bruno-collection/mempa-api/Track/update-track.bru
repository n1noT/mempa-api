meta {
  name: update-track
  type: http
  seq: 4
}

put {
  url: {{url}}/tracks/1
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Cyprien clash Squeezie",
    "artist": "Cyprien",
    "styleId": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Update an existing track. Accepts `multipart/form-data`.
  If a new audio file is provided, the previous file on disk is deleted automatically.

  **Required fields:** `title`, `artist`, `styleId`
  **Optional fields:** `album`, `genre`, `durationSeconds`, `coverUrl`
  Returns 404 if the track does not exist.

  **Admin only.** Requires ADMIN role.
}
