meta {
  name: delete-style
  type: http
  seq: 3
}

delete {
  url: {{url}}/styles/1
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Delete a music style by ID. Cascades to all playlists and tracks associated with this style.

  Returns 204 on success. Returns 404 if the style does not exist.

  **Admin only.** Requires ADMIN role.
}
