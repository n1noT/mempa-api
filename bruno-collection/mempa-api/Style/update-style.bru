meta {
  name: update-style
  type: http
  seq: 4
}

put {
  url: {{url}}/styles/1
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Rap"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Update the name of an existing music style.

  Returns 404 if the style does not exist.

  **Admin only.** Requires ADMIN role.
}
