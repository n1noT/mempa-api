meta {
  name: register
  type: http
  seq: 3
}

post {
  url: {{url}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "Nino",
    "email": "nino.toutain@utoulouse.fr",
    "password": "nino.toutain@utoulouse.fr"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Create a new user account. Password is hashed with bcrypt. A session is started immediately on success.

  Returns 409 if the email is already taken.
}
